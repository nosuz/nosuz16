+namespace {
+class AsmInfo : public MCAsmInfoELF {
+public:AsmInfo(const MCTargetOptions &O):MCAsmInfoELF(O) {
+ CodePointerSize=2;CalleeSaveStackSlotSize=2;CommentString="#";SupportsDebugInformation=false;MinInstAlignment=2;MaxInstLength=74;
+}
+};
+class Printer : public MCInstPrinter {
+ void operand(const MCOperand &O,raw_ostream &S) {
+  if(O.isReg())printRegName(S,O.getReg());else if(O.isImm())S<<O.getImm();else MAI.printExpr(S,*O.getExpr());
+ }
+public:Printer(const MCAsmInfo &A,const MCInstrInfo &I,const MCRegisterInfo &R):MCInstPrinter(A,I,R) {}
+ void printRegName(raw_ostream &O,MCRegister R) override {O<<StringRef(MRI.getName(R)).lower();}
+ std::pair<const char *,uint64_t> getMnemonic(const MCInst &I) const override{return {MII.getName(I.getOpcode()).data(),0};}
+ void printInst(const MCInst *I,uint64_t,StringRef Annot,const MCSubtargetInfo &,raw_ostream &O) override {
+  StringRef Name=MII.getName(I->getOpcode());
+  if(I->getOpcode()==Nosuz16::JMP)Name="ljmp";if(I->getOpcode()==Nosuz16::CALL)Name="lcall";
+  O<<'\t'<<Name.lower();
+  for(unsigned N=0;N<I->getNumOperands();++N) {
+   O<<(N?", ":" ");
+   if((I->getOpcode()==Nosuz16::LD||I->getOpcode()==Nosuz16::ST||I->getOpcode()==Nosuz16::LDB||I->getOpcode()==Nosuz16::STB)&&N==1) {
+    O<<'[';operand(I->getOperand(N),O);O<<" + ";operand(I->getOperand(N+1),O);O<<']';break;
+   }
+   operand(I->getOperand(N),O);
+  }
+  printAnnotation(O,Annot);
+ }
+};
+class Emitter : public MCCodeEmitter {
+ MCContext &Ctx;const MCRegisterInfo &MRI;
+ void word(unsigned W,SmallVectorImpl<char> &B) const {B.push_back(W&255);B.push_back((W>>8)&255);}
+ unsigned r(const MCInst &I,unsigned N) const {return MRI.getEncodingValue(I.getOperand(N).getReg());}
+ int64_t imm(const MCInst &I,unsigned N,unsigned Bits) const {
+  if(!I.getOperand(N).isImm()){Ctx.reportError(I.getLoc(),"expected immediate");return 0;}
+  int64_t V=I.getOperand(N).getImm();if(!isIntN(Bits,V))Ctx.reportError(I.getLoc(),"immediate out of range");return V;
+ }
+ void load(unsigned R,const MCOperand &V,SmallVectorImpl<char> &B,SmallVectorImpl<MCFixup> &F,bool Control=false) const {
+  unsigned Offset=B.size();unsigned Value=V.isImm()?V.getImm():0;
+  if(Control && V.isImm() && (Value&1)){Ctx.reportError(SMLoc(),"control target must be an even byte address");return;}
+  if(V.isExpr())F.push_back(MCFixup::create(Offset,V.getExpr(),(MCFixupKind)(Control?Nosuz16::CONTROL16:Nosuz16::ADDRESS16)));
+  word((R<<9)|(R<<6)|6,B);
+  for(int Bit=15;Bit>=0;--Bit){word((R<<9)|7,B);word(0x1000|(R<<9)|(R<<6)|((Value>>Bit)&1),B);}
+ }
+ void longJump(unsigned R,unsigned Link,const MCOperand &Dst,SmallVectorImpl<char> &B,SmallVectorImpl<MCFixup> &F) const {load(R,Dst,B,F,true);word(0x8000|(Link<<9)|(R<<6),B);}
+public:Emitter(MCContext &C,const MCRegisterInfo &R):Ctx(C),MRI(R) {}
+ void encodeInstruction(const MCInst &I,SmallVectorImpl<char> &B,SmallVectorImpl<MCFixup> &F,const MCSubtargetInfo &) const override {
+  unsigned Op=I.getOpcode(),Fun=0;
+  switch(Op) {
+#define A(X,V) case Nosuz16::X:Fun=V;break;
+   A(ADD,0) A(SUB,1) A(ADDC,2) A(SUBC,3) A(AND,4) A(OR,5) A(XOR,6)
+#undef A
+   case Nosuz16::SLL:word((r(I,0)<<9)|7,B);return;
+   case Nosuz16::SRL:word((r(I,0)<<9)|8,B);return;
+   case Nosuz16::ASR:word((r(I,0)<<9)|9,B);return;
+   case Nosuz16::MOV:{unsigned D=r(I,0),S=r(I,1);if(D==S)word(0x1000|(D<<9)|(D<<6),B);else{word((D<<9)|(D<<6)|6,B);word((D<<9)|(S<<6),B);}return;}
+   case Nosuz16::LI:load(r(I,0),I.getOperand(1),B,F);return;
+   case Nosuz16::JMP:longJump(5,0,I.getOperand(0),B,F);return;
+   case Nosuz16::CALL:longJump(7,7,I.getOperand(0),B,F);return;
+   case Nosuz16::RET:word(0x81c0,B);return;
+   case Nosuz16::HALT:word(0xf000,B);return;
+   case Nosuz16::ADDI:word(0x1000|(r(I,0)<<9)|(r(I,0)<<6)|(imm(I,1,6)&63),B);return;
+   case Nosuz16::LD:case Nosuz16::ST:case Nosuz16::LDB:case Nosuz16::STB:word((Op==Nosuz16::LD?0x2000:Op==Nosuz16::ST?0x3000:Op==Nosuz16::LDB?0x9000:0xa000)|(r(I,0)<<9)|(r(I,1)<<6)|(imm(I,2,6)&63),B);return;
+   case Nosuz16::JALR:word(0x8000|(r(I,0)<<9)|(r(I,1)<<6)|(imm(I,2,6)&63),B);return;
+   case Nosuz16::BEQ:case Nosuz16::BNE:case Nosuz16::BLT:case Nosuz16::JAL:{
+    bool Jump=Op==Nosuz16::JAL;unsigned Bits=Jump?9:6,Index=Jump?1:2;
+    unsigned W=Jump?0x7000:Op==Nosuz16::BEQ?0x4000:Op==Nosuz16::BNE?0x5000:0x6000;
+    W|=r(I,0)<<9;if(!Jump)W|=r(I,1)<<6;
+    auto &V=I.getOperand(Index);
+    if(V.isImm())W|=imm(I,Index,Bits)&((1<<Bits)-1);
+    else F.push_back(MCFixup::create(B.size(),V.getExpr(),(MCFixupKind)(Jump?Nosuz16::PC9:Nosuz16::PC6),true));
+    word(W,B);return;
+   }
+   case Nosuz16::BRCC:{
+    auto CC=(ISD::CondCode)I.getOperand(2).getImm();unsigned A=r(I,0),D=r(I,1),Code=0x6000;bool Invert=false;
+    switch(CC){case ISD::SETEQ:Code=0x4000;break;case ISD::SETNE:Code=0x5000;break;case ISD::SETLT:break;case ISD::SETGT:std::swap(A,D);break;case ISD::SETGE:Invert=true;break;case ISD::SETLE:std::swap(A,D);Invert=true;break;default:Ctx.reportError(I.getLoc(),"unsupported branch condition");return;}
+    word(Code|(A<<9)|(D<<6)|1,B);
+    if(Invert){word(0x7001,B);word(0x7022,B);}else word(0x7022,B);
+    longJump(5,0,I.getOperand(3),B,F);return;
+   }
+   default:Ctx.reportError(I.getLoc(),"unsupported Nosuz16 instruction");return;
+  }
+  word((r(I,0)<<9)|(r(I,1)<<6)|Fun,B);
+ }
+};
+// Private transport object, not a registered public ELF ABI. image.py consumes it.
+class ObjectWriter : public MCELFObjectTargetWriter {
+public:ObjectWriter():MCELFObjectTargetWriter(false,0,ELF::EM_NONE,true) {}
+ unsigned getRelocType(const MCFixup &F,const MCValue &,bool) const override {
+  switch(F.getKind()){case Nosuz16::PC6:return 1;case Nosuz16::PC9:return 2;case Nosuz16::ADDRESS16:return 3;case FK_Data_2:return 4;case Nosuz16::CONTROL16:return 6;default:report_fatal_error("Nosuz16: unsupported relocation",false);}
+ }
+};
+class Backend : public MCAsmBackend {
+public:Backend():MCAsmBackend(endianness::little) {}
+ bool finishLayout() const override {
+  static_cast<ELFObjectWriter &>(Asm->getWriter()).setELFHeaderEFlags(0x205);
+  return false;
+ }
+ std::unique_ptr<MCObjectTargetWriter> createObjectTargetWriter() const override{return std::make_unique<ObjectWriter>();}
+ MCFixupKindInfo getFixupKindInfo(MCFixupKind K) const override {
+  if(K<FirstTargetFixupKind)return MCAsmBackend::getFixupKindInfo(K);
+  static const MCFixupKindInfo T[]={{"n16_pc6",0,6,0},{"n16_pc9",0,9,0},{"n16_addr16",0,16,0},{"n16_control16",0,16,0}};
+  return T[K-FirstTargetFixupKind];
+ }
+ void applyFixup(const MCFragment &F,const MCFixup &Fix,const MCValue &T,uint8_t *Data,uint64_t Value,bool Resolved) override {
+  maybeAddReloc(F,Fix,T,Value,Resolved);
+  if(!Resolved)return;
+  unsigned K=Fix.getKind();
+  if(K==FK_Data_2) {
+   if(Value>65535){getContext().reportError(SMLoc(),"byte pointer exceeds address space");return;}
+   Data[0]=Value&255;Data[1]=(Value>>8)&255;return;
+  }
+  if(K==Nosuz16::ADDRESS16 || K==Nosuz16::CONTROL16) {
+   if(K==Nosuz16::CONTROL16 && (Value&1)){getContext().reportError(SMLoc(),"control target must be an even byte address");return;}
+   if(Value>65535){getContext().reportError(SMLoc(),"byte target exceeds address space");return;}
+   for(unsigned I=0;I<16;++I){unsigned At=(2+I*2)*2;Data[At]=(Data[At]&~1)|((Value>>(15-I))&1);}
+   return;
+  }
+  if(K==Nosuz16::PC6||K==Nosuz16::PC9) {
+   if(Value&1){getContext().reportError(SMLoc(),"unaligned branch target");return;}
+   int64_t Offset=int16_t(uint16_t(Value-2))/2;unsigned Bits=K==Nosuz16::PC6?6:9;
+   if(!isIntN(Bits,Offset)){getContext().reportError(SMLoc(),"branch offset out of range");return;}
+   Value=Offset&((1<<Bits)-1);
+  }
+  Data[0]|=Value&255;Data[1]|=(Value>>8)&255;
+ }
+ bool writeNopData(raw_ostream &O,uint64_t N,const MCSubtargetInfo *) const override {if(N%2)return false;while(N){O.write("\x00\x70",2);N-=2;}return true;}
+};
+}
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void LLVMInitializeNosuz16TargetMC() {
+ auto &T=getTheNosuz16Target();
+ TargetRegistry::RegisterMCAsmInfo(T,[](const MCRegisterInfo &,const Triple &,const MCTargetOptions &O)->MCAsmInfo *{return new AsmInfo(O);});
+ TargetRegistry::RegisterMCInstrInfo(T,[](){auto *I=new MCInstrInfo();InitNosuz16MCInstrInfo(I);return I;});
+ TargetRegistry::RegisterMCRegInfo(T,[](const Triple &){auto *R=new MCRegisterInfo();InitNosuz16MCRegisterInfo(R,Nosuz16::R7);return R;});
+ TargetRegistry::RegisterMCSubtargetInfo(T,[](const Triple &TT,StringRef C,StringRef F){return createNosuz16MCSubtargetInfoImpl(TT,C.empty()?"generic":C,C.empty()?"generic":C,F);});
+ TargetRegistry::RegisterMCInstPrinter(T,[](const Triple &,unsigned,const MCAsmInfo &A,const MCInstrInfo &I,const MCRegisterInfo &R)->MCInstPrinter *{return new Printer(A,I,R);});
+ TargetRegistry::RegisterMCCodeEmitter(T,[](const MCInstrInfo &,MCContext &C)->MCCodeEmitter *{return new Emitter(C,*C.getRegisterInfo());});
+ TargetRegistry::RegisterMCAsmBackend(T,[](const Target &,const MCSubtargetInfo &,const MCRegisterInfo &,const MCTargetOptions &)->MCAsmBackend *{return new Backend();});
+}
