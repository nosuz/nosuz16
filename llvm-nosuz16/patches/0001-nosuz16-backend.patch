diff --git a/llvm/lib/Target/Nosuz16/AsmParser/Nosuz16AsmParser.cpp b/llvm/lib/Target/Nosuz16/AsmParser/Nosuz16AsmParser.cpp
new file mode 100644
index 000000000..32776f90b
--- /dev/null
+++ b/llvm/lib/Target/Nosuz16/AsmParser/Nosuz16AsmParser.cpp
@@ -0,0 +1,100 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "MCTargetDesc/Nosuz16MC.h"
+#include "llvm/CodeGen/ISDOpcodes.h"
+#include "TargetInfo/Nosuz16TargetInfo.h"
+#include "llvm/MC/MCContext.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCParser/MCAsmParser.h"
+#include "llvm/MC/MCParser/MCParsedAsmOperand.h"
+#include "llvm/MC/MCParser/MCTargetAsmParser.h"
+#include "llvm/MC/MCStreamer.h"
+#include "llvm/MC/TargetRegistry.h"
+#include "llvm/Support/MathExtras.h"
+using namespace llvm;
+namespace {
+struct Packet : MCParsedAsmOperand {
+ SmallVector<MCInst,3> Instructions;SMLoc Loc;
+ bool isToken() const override{return false;}bool isReg() const override{return false;}bool isImm() const override{return false;}bool isMem() const override{return false;}
+ MCRegister getReg() const override{return MCRegister();}
+ SMLoc getStartLoc() const override{return Loc;}SMLoc getEndLoc() const override{return Loc;}
+ void print(raw_ostream &O, const MCAsmInfo &) const override{O<<"Nosuz16 instruction";}
+};
+class Parser : public MCTargetAsmParser {
+ bool comma(){return getParser().parseToken(AsmToken::Comma,"expected ','");}
+ bool reg(MCOperand &O){MCRegister R;SMLoc A,B;if(parseRegister(R,A,B))return true;O=MCOperand::createReg(R);return false;}
+ bool value(MCOperand &O,unsigned Bits=0,bool Signed=true) {
+  const MCExpr *E;if(getParser().parseExpression(E))return true;int64_t V;
+  if(E->evaluateAsAbsolute(V)) {
+   if(Bits && !(Signed?isIntN(Bits,V):isUIntN(Bits,V)))return Error(getParser().getTok().getLoc(),"immediate out of range");
+   O=MCOperand::createImm(V);
+  } else {if(Bits && Bits!=9)return Error(getParser().getTok().getLoc(),"expected constant immediate");O=MCOperand::createExpr(E);}
+  return false;
+ }
+public:
+ void convertToMapAndConstraints(unsigned, const OperandVector &) override {}
+ Parser(const MCSubtargetInfo &S,MCAsmParser &,const MCInstrInfo &I):MCTargetAsmParser(S,I) {}
+ ParseStatus tryParseRegister(MCRegister &R,SMLoc &A,SMLoc &B) override {
+  auto &P=getParser();A=B=P.getTok().getLoc();if(!P.getTok().is(AsmToken::Identifier))return ParseStatus::NoMatch;
+  std::string N=P.getTok().getString().lower();unsigned Id=8;
+  if(N.size()==2 && N[0]=='r' && N[1]>='0' && N[1]<='7')Id=N[1]-'0';
+  else if(N=="sp")Id=6;else if(N=="ra"||N=="lr")Id=7;else if(N=="zero")Id=0;
+  if(Id==8)return ParseStatus::NoMatch;R=Nosuz16::reg(Id);P.Lex();return ParseStatus::Success;
+ }
+ bool parseRegister(MCRegister &R,SMLoc &A,SMLoc &B) override {if(!tryParseRegister(R,A,B).isSuccess())return Error(A,"expected r0-r7 register");return false;}
+ bool parseInstruction(ParseInstructionInfo &,StringRef Mn,SMLoc Loc,OperandVector &Operands) override {
+  std::string N=Mn.lower();auto PacketPtr=std::make_unique<Packet>();PacketPtr->Loc=Loc;MCInst I;I.setLoc(Loc);
+  MCOperand A,B,C;unsigned Op=0;auto &P=getParser();
+  auto emit=[&](unsigned O,std::initializer_list<MCOperand> Args){MCInst X;X.setOpcode(O);X.setLoc(Loc);for(auto V:Args)X.addOperand(V);PacketPtr->Instructions.push_back(X);};
+  static const std::pair<const char *,unsigned> Binary[]={{"add",Nosuz16::ADD},{"sub",Nosuz16::SUB},{"addc",Nosuz16::ADDC},{"subc",Nosuz16::SUBC},{"and",Nosuz16::AND},{"or",Nosuz16::OR},{"xor",Nosuz16::XOR},{"mov",Nosuz16::MOV}};
+  for(auto [Name,O]:Binary)if(N==Name)Op=O;
+  if(Op){if(reg(A)||comma()||reg(B))return true;emit(Op,{A,B});}
+  else if(N=="sll"||N=="srl"||N=="asr"||N=="clr"||N=="inc"||N=="dec") {
+   if(reg(A))return true;
+   if(N=="clr")emit(Nosuz16::XOR,{A,A});
+   else if(N=="inc"||N=="dec")emit(Nosuz16::ADDI,{A,MCOperand::createImm(N=="inc"?1:-1)});
+   else emit(N=="sll"?Nosuz16::SLL:N=="srl"?Nosuz16::SRL:Nosuz16::ASR,{A});
+  } else if(N=="nop")emit(Nosuz16::JAL,{MCOperand::createReg(Nosuz16::R0),MCOperand::createImm(0)});
+  else if(N=="halt")emit(Nosuz16::HALT,{});
+  else if(N=="ret")emit(Nosuz16::RET,{});
+  else if(N=="addi"||N=="subi"||N=="li") {
+   if(reg(A)||comma()||value(B,N=="addi"?6:0))return true;
+   if(N=="subi"){if(!B.isImm()||B.getImm() < -31||B.getImm()>32)return Error(Loc,"SUBI range is -31..32");B=MCOperand::createImm(-B.getImm());}
+   if(N=="li"&&B.isImm()&&(B.getImm() < -32768||B.getImm()>65535))return Error(Loc,"LI value must fit a word");
+   emit(N=="li"?Nosuz16::LI:Nosuz16::ADDI,{A,B});
+  } else if(N=="ld"||N=="st"||N=="ldb"||N=="stb") {
+   if(reg(A)||comma()||P.parseToken(AsmToken::LBrac,"expected '['")||reg(B))return true;
+   C=MCOperand::createImm(0);if(!P.getTok().is(AsmToken::RBrac)) {
+    if(!P.getTok().is(AsmToken::Plus)&&!P.getTok().is(AsmToken::Minus))return Error(Loc,"expected '+' or '-' offset");
+    if(P.getTok().is(AsmToken::Plus))P.Lex();if(value(C,6))return true;
+   }
+   if(P.parseToken(AsmToken::RBrac,"expected ']'") )return true;emit(N=="ld"?Nosuz16::LD:N=="st"?Nosuz16::ST:N=="ldb"?Nosuz16::LDB:Nosuz16::STB,{A,B,C});
+  } else if(N=="jalr") {if(reg(A)||comma()||reg(B)||comma()||value(C,6))return true;emit(Nosuz16::JALR,{A,B,C});}
+  else if(N=="beq"||N=="bne"||N=="blt") {
+   if(reg(A)||comma()||reg(B)||comma()||value(C))return true;
+   if(C.isImm()&&!isInt<6>(C.getImm()))return Error(Loc,"branch offset out of range");
+   emit(N=="beq"?Nosuz16::BEQ:N=="bne"?Nosuz16::BNE:Nosuz16::BLT,{A,B,C});
+  } else if(N=="jal"||N=="jmp"||N=="call"||N=="ljmp"||N=="lcall") {
+   if(N=="jal"){if(reg(A)||comma())return true;}else A=MCOperand::createReg(N=="call"?Nosuz16::R7:Nosuz16::R0);
+   if(value(B))return true;
+   if((N=="jal"||N=="jmp"||N=="call")&&B.isImm()&&!isInt<9>(B.getImm()))return Error(Loc,"jump offset out of range");
+   if((N=="ljmp"||N=="lcall")&&B.isImm()&&!isUInt<16>(B.getImm()))return Error(Loc,"absolute jump address must be 0..65535");
+   if(N=="ljmp"||N=="lcall")emit(N=="ljmp"?Nosuz16::JMP:Nosuz16::CALL,{B});else emit(Nosuz16::JAL,{A,B});
+  } else if(N=="cmp") {
+   if(reg(A)||comma()||reg(B)||comma()||reg(C))return true;
+   if(C.getReg()==Nosuz16::R0||C.getReg()==A.getReg()||C.getReg()==B.getReg())return Error(Loc,"CMP scratch must differ from r0 and both inputs");
+   emit(Nosuz16::MOV,{C,A});emit(Nosuz16::SUB,{C,B});
+  } else if(N=="brcc") {
+   MCOperand D;if(reg(A)||comma()||reg(B)||comma()||value(C)||comma()||value(D))return true;
+   if(!C.isImm())return Error(Loc,"expected constant branch condition");
+   switch(C.getImm()){case ISD::SETEQ:case ISD::SETNE:case ISD::SETLT:case ISD::SETLE:case ISD::SETGT:case ISD::SETGE:break;default:return Error(Loc,"unsupported branch condition");}
+   emit(Nosuz16::BRCC,{A,B,C,D});
+  } else return Error(Loc,"unknown Nosuz16 instruction");
+  if(P.parseEOL())return true;Operands.push_back(std::move(PacketPtr));return false;
+ }
+ bool matchAndEmitInstruction(SMLoc,unsigned &Opcode,OperandVector &Operands,MCStreamer &Out,uint64_t &,bool) override {
+  auto &P=static_cast<Packet &>(*Operands[0]);for(auto &I:P.Instructions){Opcode=I.getOpcode();Out.emitInstruction(I,getSTI());}return false;
+ }
+};
+}
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void LLVMInitializeNosuz16AsmParser(){RegisterMCAsmParser<Parser> X(getTheNosuz16Target());}
