+ void copyPhysReg(MachineBasicBlock &,MachineBasicBlock::iterator,const DebugLoc &,Register,Register,bool,bool=false,bool=false) const override;
+ void storeRegToStackSlot(MachineBasicBlock &,MachineBasicBlock::iterator,Register,bool,int,const TargetRegisterClass *,Register,MachineInstr::MIFlag=MachineInstr::NoFlags) const override;
+ void loadRegFromStackSlot(MachineBasicBlock &,MachineBasicBlock::iterator,Register,int,const TargetRegisterClass *,Register,unsigned=0,MachineInstr::MIFlag=MachineInstr::NoFlags) const override;
+ bool expandPostRAPseudo(MachineInstr &) const override;
+ bool analyzeBranch(MachineBasicBlock &,MachineBasicBlock *&,MachineBasicBlock *&,SmallVectorImpl<MachineOperand> &,bool=false) const override;
+ unsigned insertBranch(MachineBasicBlock &,MachineBasicBlock *,MachineBasicBlock *,ArrayRef<MachineOperand>,const DebugLoc &,int * =nullptr) const override;
