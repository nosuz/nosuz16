+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+let TargetPrefix = "nosuz16" in {
+// Side effects and unknown memory effects deliberately preserve MMIO ordering.
+def int_nosuz16_ldw : Intrinsic<[llvm_i16_ty], [llvm_i16_ty], [IntrHasSideEffects]>;
+def int_nosuz16_stw : Intrinsic<[], [llvm_i16_ty, llvm_i16_ty], [IntrHasSideEffects]>;
+def int_nosuz16_ldb : Intrinsic<[llvm_i16_ty], [llvm_i16_ty], [IntrHasSideEffects]>;
+def int_nosuz16_stb : Intrinsic<[], [llvm_i16_ty, llvm_i16_ty], [IntrHasSideEffects]>;
+}
