diff --git a/llvm/lib/Target/Nosuz16/Disassembler/Nosuz16Disassembler.cpp b/llvm/lib/Target/Nosuz16/Disassembler/Nosuz16Disassembler.cpp
new file mode 100644
index 000000000..36121c718
--- /dev/null
+++ b/llvm/lib/Target/Nosuz16/Disassembler/Nosuz16Disassembler.cpp
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "MCTargetDesc/Nosuz16MC.h"
+#include "TargetInfo/Nosuz16TargetInfo.h"
+#include "llvm/MC/MCDisassembler/MCDisassembler.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/TargetRegistry.h"
+using namespace llvm;
+namespace {
+class Decoder : public MCDisassembler {
+public:Decoder(const MCSubtargetInfo &S,MCContext &C):MCDisassembler(S,C) {}
+ DecodeStatus getInstruction(MCInst &I,uint64_t &Size,ArrayRef<uint8_t> B,uint64_t,raw_ostream &) const override {
+  Size=0;if(B.size()<2)return Fail;Size=2;unsigned W=B[0]|(unsigned(B[1])<<8),Op=W>>12,D=(W>>9)&7,S=(W>>6)&7,F=W&63;
+  auto R=[&](unsigned N){I.addOperand(MCOperand::createReg(Nosuz16::reg(N)));};
+  auto Imm=[&](unsigned V,unsigned Bits){I.addOperand(MCOperand::createImm(int16_t(V<<(16-Bits))>>(16-Bits)));};
+  if(!Op){static const unsigned Ops[]={Nosuz16::ADD,Nosuz16::SUB,Nosuz16::ADDC,Nosuz16::SUBC,Nosuz16::AND,Nosuz16::OR,Nosuz16::XOR,Nosuz16::SLL,Nosuz16::SRL,Nosuz16::ASR};if(F>9)return Fail;I.setOpcode(Ops[F]);R(D);if(F<7)R(S);return Success;}
+  static const unsigned Ops[]={0,Nosuz16::ADDI,Nosuz16::LD,Nosuz16::ST,Nosuz16::BEQ,Nosuz16::BNE,Nosuz16::BLT,Nosuz16::JAL,Nosuz16::JALR,Nosuz16::LDB,Nosuz16::STB};
+  if(W==0xf000){I.setOpcode(Nosuz16::HALT);return Success;}if(Op>10)return Fail;
+  I.setOpcode(Ops[Op]);R(D);if(Op!=1&&Op!=7)R(S);Imm(Op==7?W&511:F,Op==7?9:6);return Success;
+ }
+};
+}
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void LLVMInitializeNosuz16Disassembler(){TargetRegistry::RegisterMCDisassembler(getTheNosuz16Target(),[](const Target &,const MCSubtargetInfo &S,MCContext &C)->MCDisassembler *{return new Decoder(S,C);});}
