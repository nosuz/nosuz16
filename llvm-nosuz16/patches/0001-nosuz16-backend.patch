diff --git a/llvm/lib/Target/Nosuz16/Nosuz16.td b/llvm/lib/Target/Nosuz16/Nosuz16.td
new file mode 100644
index 000000000..036135c42
--- /dev/null
+++ b/llvm/lib/Target/Nosuz16/Nosuz16.td
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+include "llvm/Target/Target.td"
+class NReg<bits<3> num, string name> : Register<name> {
+ let Namespace = "Nosuz16"; let HWEncoding = 0; let HWEncoding{2-0} = num;
+}
+def R0 : NReg<0, "r0">;
+def R1 : NReg<1, "r1">;
+def R2 : NReg<2, "r2">;
+def R3 : NReg<3, "r3">;
+def R4 : NReg<4, "r4">;
+def R5 : NReg<5, "r5">;
+def R6 : NReg<6, "r6">;
+def R7 : NReg<7, "r7">;
+
+def STATUS : Register<"status"> { let Namespace = "Nosuz16"; }
+def GPR : RegisterClass<"Nosuz16", [i16], 16, (add R1,R2,R3,R4,R5,R6,R7,R0)>;
+def CSR_Function : CalleeSavedRegs<(add R4,R5,R7)>;
+def CSR_ABI : CalleeSavedRegs<(add R4,R5,R6)>;
+def nimm : Operand<i16>;
+def target : Operand<OtherVT>;
+class Inst<dag outs, dag ins, string asm, int size=2> : Instruction {
+ let Namespace="Nosuz16"; let OutOperandList=outs; let InOperandList=ins;
+ let AsmString=asm; let Size=size; let hasSideEffects=0;
+}
+class Binary<string name> : Inst<(outs GPR:$rd), (ins GPR:$a,GPR:$rs), name # " $rd, $rs"> {
+ let Constraints="$rd = $a"; let Defs=[STATUS];
+}
+def ADD : Binary<"add">;
+def SUB : Binary<"sub">;
+let Uses=[STATUS] in def ADDC : Binary<"addc">;
+let Uses=[STATUS] in def SUBC : Binary<"subc">;
+def AND : Binary<"and">;
+def OR : Binary<"or">;
+def XOR : Binary<"xor">;
+
+class Shift<string name> : Inst<(outs GPR:$rd), (ins GPR:$a), name # " $rd"> {
+ let Constraints="$rd = $a"; let Defs=[STATUS];
+}
+def SLL : Shift<"sll">; def SRL : Shift<"srl">; def ASR : Shift<"asr">;
+def ADDI : Inst<(outs GPR:$rd),(ins GPR:$a,nimm:$imm),"addi $rd, $imm"> {
+ let Constraints="$rd = $a"; let Defs=[STATUS];
+}
+def LD : Inst<(outs GPR:$rd),(ins GPR:$base,nimm:$offset),"ld $rd, [$base+$offset]"> { let mayLoad=1; }
+def ST : Inst<(outs),(ins GPR:$rs,GPR:$base,nimm:$offset),"st $rs, [$base+$offset]"> { let mayStore=1; }
+def LDB : Inst<(outs GPR:$rd),(ins GPR:$base,nimm:$offset),"ldb $rd, [$base+$offset]"> { let mayLoad=1; }
+def STB : Inst<(outs),(ins GPR:$rs,GPR:$base,nimm:$offset),"stb $rs, [$base+$offset]"> { let mayStore=1; }
+let isPseudo=1, Defs=[R6,STATUS], Uses=[R6] in {
+ def LDSP : Inst<(outs GPR:$rd),(ins GPR:$base,nimm:$offset),""> { let mayLoad=1; }
+ def STSP : Inst<(outs),(ins GPR:$rs,GPR:$base,nimm:$offset),""> { let mayStore=1; }
+}
+class Branch<string n> : Inst<(outs),(ins GPR:$a,GPR:$b,target:$dst),n # " $a, $b, $dst"> {
+ let isBranch=1; let isTerminator=1;
+}
+def BEQ : Branch<"beq">; def BNE : Branch<"bne">; def BLT : Branch<"blt">;
+def JAL : Inst<(outs GPR:$rd),(ins target:$dst),"jal $rd, $dst">;
+def JALR : Inst<(outs GPR:$rd),(ins GPR:$base,nimm:$offset),"jalr $rd, $base, $offset">;
+def HALT : Inst<(outs),(ins),"halt"> { let hasSideEffects=1; let isTerminator=1; let isBarrier=1; }
+def MOV : Inst<(outs GPR:$rd),(ins GPR:$rs),"mov $rd, $rs",4> { let isPseudo=1; let Defs=[STATUS]; }
+def LI : Inst<(outs GPR:$rd),(ins nimm:$value),"li $rd, $value",66> { let isPseudo=1; let Defs=[STATUS]; }
+def LEA : Inst<(outs GPR:$rd),(ins GPR:$base,nimm:$offset),""> { let isPseudo=1; let Defs=[STATUS]; }
+def RET : Inst<(outs),(ins variable_ops),"ret"> { let isPseudo=1; let Uses=[R7]; let isReturn=1; let isTerminator=1; let isBarrier=1; }
+def JMP : Inst<(outs),(ins target:$dst),"ljmp $dst",68> {
+ let isPseudo=1; let isBranch=1; let isTerminator=1; let isBarrier=1; let Defs=[R5,STATUS];
+}
+def BRCC : Inst<(outs),(ins GPR:$a,GPR:$b,nimm:$cc,target:$dst),"brcc $a, $b, $cc, $dst",74> {
+ let isPseudo=1; let isBranch=1; let isTerminator=1; let Defs=[R5,STATUS];
+}
+def CALL : Inst<(outs),(ins target:$dst, variable_ops),"lcall $dst",68> {
+ let isPseudo=1; let isCall=1; let Defs=[R7,STATUS]; let Uses=[R6]; let hasSideEffects=1;
+}
+def SELECT : Inst<(outs GPR:$rd),(ins GPR:$a,GPR:$b,nimm:$cc,GPR:$t,GPR:$f),""> {
+ let isPseudo=1; let usesCustomInserter=1;
+}
+class VShift : Inst<(outs GPR:$rd),(ins GPR:$a,GPR:$count),""> { let isPseudo=1; let usesCustomInserter=1; }
+def VSHL : VShift; def VSRL : VShift; def VSRA : VShift;
+def ADJCALLSTACKDOWN : Inst<(outs),(ins nimm:$amt,nimm:$align),""> { let isPseudo=1; let Defs=[R6,STATUS]; let Uses=[R6]; }
+def ADJCALLSTACKUP : Inst<(outs),(ins nimm:$amt,nimm:$pop),""> { let isPseudo=1; let Defs=[R6,STATUS]; let Uses=[R6]; }
+def : Processor<"generic", NoItineraries, []>;
+defm : RemapAllTargetPseudoPointerOperands<GPR>;
+def Nosuz16InstrInfo : InstrInfo;
+def Nosuz16 : Target { let InstructionSet=Nosuz16InstrInfo; }
diff --git a/llvm/lib/Target/Nosuz16/Nosuz16AsmPrinter.cpp b/llvm/lib/Target/Nosuz16/Nosuz16AsmPrinter.cpp
new file mode 100644
index 000000000..9119f9fea
--- /dev/null
+++ b/llvm/lib/Target/Nosuz16/Nosuz16AsmPrinter.cpp
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "Nosuz16.h"
+#include "TargetInfo/Nosuz16TargetInfo.h"
+#include "llvm/CodeGen/AsmPrinter.h"
+#include "llvm/MC/MCInst.h"
+#include "llvm/MC/MCExpr.h"
+#include "llvm/MC/MCStreamer.h"
+#include "llvm/MC/TargetRegistry.h"
+using namespace llvm;
+namespace {
+class N16AsmPrinter : public AsmPrinter {
+public:N16AsmPrinter(TargetMachine &TM,std::unique_ptr<MCStreamer> S):AsmPrinter(TM,std::move(S)) {}
+ StringRef getPassName() const override{return "Nosuz16 assembly printer";}
+ void emitInstruction(const MachineInstr *MI) override {
+  MCInst I;I.setOpcode(MI->getOpcode());
+  for(const auto &O:MI->operands()) {
+   if(O.isReg() && !O.isImplicit()) I.addOperand(MCOperand::createReg(O.getReg()));
+   else if(O.isImm())I.addOperand(MCOperand::createImm(O.getImm()));
+   else if(O.isMBB())I.addOperand(MCOperand::createExpr(MCSymbolRefExpr::create(O.getMBB()->getSymbol(),OutContext)));
+   else if(O.isGlobal())I.addOperand(MCOperand::createExpr(MCBinaryExpr::createAdd(MCSymbolRefExpr::create(getSymbol(O.getGlobal()),OutContext),MCConstantExpr::create(O.getOffset(),OutContext),OutContext)));
+   else if(O.isSymbol())I.addOperand(MCOperand::createExpr(MCSymbolRefExpr::create(GetExternalSymbolSymbol(O.getSymbolName()),OutContext)));
+  }
+  // MC form omits the tied old-destination operand.
+  unsigned Op=I.getOpcode();
+  if(Op==Nosuz16::ADD||Op==Nosuz16::SUB||Op==Nosuz16::ADDC||Op==Nosuz16::SUBC||Op==Nosuz16::AND||Op==Nosuz16::OR||Op==Nosuz16::XOR||Op==Nosuz16::ADDI||Op==Nosuz16::SLL||Op==Nosuz16::SRL||Op==Nosuz16::ASR)I.erase(I.begin()+1);
+  if(Op==Nosuz16::CALL)while(I.getNumOperands()>1)I.erase(I.end()-1);
+  if(Op==Nosuz16::RET)while(I.getNumOperands())I.erase(I.end()-1);
+  EmitToStreamer(*OutStreamer,I);
+ }
+};
+
+}
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void LLVMInitializeNosuz16AsmPrinter() {
+ RegisterAsmPrinter<N16AsmPrinter> AP(getTheNosuz16Target());
+}
diff --git a/llvm/lib/Target/Nosuz16/Nosuz16Memory.cpp b/llvm/lib/Target/Nosuz16/Nosuz16Memory.cpp
new file mode 100644
index 000000000..2f59d7590
--- /dev/null
+++ b/llvm/lib/Target/Nosuz16/Nosuz16Memory.cpp
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "Nosuz16.h"
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/IR/InstIterator.h"
+#include "llvm/IR/IntrinsicInst.h"
+#include "llvm/IR/IntrinsicsNosuz16.h"
+#include "llvm/IR/Module.h"
+#include "llvm/Pass.h"
+#include "llvm/Support/ErrorHandling.h"
+
+using namespace llvm;
+namespace {
+// v2.5 packed byte memory; scalar alignment controls word versus byte access.
+class N16Memory final : public ModulePass {
+public:
+  static char ID;
+  N16Memory() : ModulePass(ID) {}
+  bool runOnModule(Module &M) override {
+    SmallVector<Instruction *> Work;
+    for (Function &F : M)
+      for (Instruction &I : instructions(F))
+        if (isa<AllocaInst, LoadInst, StoreInst, MemIntrinsic>(I))
+          Work.push_back(&I);
+        else if (auto *II = dyn_cast<IntrinsicInst>(&I))
+          if (II->getIntrinsicID() == Intrinsic::lifetime_start ||
+              II->getIntrinsicID() == Intrinsic::lifetime_end ||
+              II->getIntrinsicID() == Intrinsic::uadd_with_overflow ||
+              II->getIntrinsicID() == Intrinsic::usub_with_overflow ||
+              II->getIntrinsicID() == Intrinsic::sadd_with_overflow ||
+              II->getIntrinsicID() == Intrinsic::ssub_with_overflow)
+            Work.push_back(&I);
+    if (Work.empty())
+      return false;
+    Type *Word = Type::getInt16Ty(M.getContext());
+    auto *Read = Intrinsic::getOrInsertDeclaration(&M, Intrinsic::nosuz16_ldw);
+    auto *Write = Intrinsic::getOrInsertDeclaration(&M, Intrinsic::nosuz16_stw);
+    auto *ReadByte =
+        Intrinsic::getOrInsertDeclaration(&M, Intrinsic::nosuz16_ldb);
+    auto *WriteByte =
+        Intrinsic::getOrInsertDeclaration(&M, Intrinsic::nosuz16_stb);
+    for (Instruction *I : Work) {
+      IRBuilder<> B(I);
+      B.SetCurrentDebugLocation(I->getDebugLoc());
+      auto Fail = [](const Twine &Reason) {
+        report_fatal_error(Twine("Nosuz16 memory: ") + Reason, false);
+      };
+      auto Address = [&](Value *P) {
+        if (P->getType()->getPointerAddressSpace() != 0)
+          Fail("non-default address spaces unsupported");
+        return B.CreatePtrToInt(P, Word);
+      };
+      if (auto *A = dyn_cast<AllocaInst>(I)) {
+        if (A->getMetadata("nosuz16.frame"))
+          continue;
+        auto *N = dyn_cast<ConstantInt>(A->getArraySize());
+        if (!N || !A->isStaticAlloca() || A->getAddressSpace() != 0)
+          Fail(
+              "dynamic or non-default-address-space stack objects unsupported");
+        if (A->getAlign().value() > 2)
+          Fail("stack alignment greater than two C bytes unsupported");
+        uint64_t Size =
+            M.getDataLayout().getTypeAllocSize(A->getAllocatedType());
+        if (N->getValue().getActiveBits() > 16 || Size > 32766 ||
+            (N->getZExtValue() && Size > 32766 / N->getZExtValue()))
+          Fail("stack object exceeds 32766 C bytes");
+        A->setMetadata("nosuz16.frame", MDNode::get(M.getContext(), {}));
+        continue;
+      } else if (auto *MI = dyn_cast<MemIntrinsic>(I)) {
+        Value *Size = MI->getLength();
+        if (!Size->getType()->isIntegerTy(16)) {
+          auto *N = dyn_cast<ConstantInt>(Size);
+          if (!N || N->getValue().getActiveBits() > 16)
+            Fail("memory intrinsic length must fit 16 bits");
+          Size = B.getInt16(N->getZExtValue());
+        }
+        if (auto *Set = dyn_cast<MemSetInst>(MI)) {
+          auto Helper = M.getOrInsertFunction("__nosuz16_memset", B.getVoidTy(),
+                                              Word, Word, Word);
+          B.CreateCall(Helper, {Address(Set->getDest()),
+                                B.CreateZExt(Set->getValue(), Word), Size});
+        } else if (auto *Copy = dyn_cast<MemTransferInst>(MI)) {
+          auto Helper = M.getOrInsertFunction(
+              isa<MemMoveInst>(MI) ? "__nosuz16_memmove" : "__nosuz16_memcpy",
+              B.getVoidTy(), Word, Word, Word);
+          B.CreateCall(Helper, {Address(Copy->getDest()),
+                                Address(Copy->getSource()), Size});
+        } else {
+          Fail("unsupported memory intrinsic");
+        }
+      } else if (auto *Overflow = dyn_cast<IntrinsicInst>(I)) {
+        unsigned ID = Overflow->getIntrinsicID();
+        if (ID != Intrinsic::lifetime_start && ID != Intrinsic::lifetime_end) {
+          Value *A = Overflow->getArgOperand(0),
+                *ArgB = Overflow->getArgOperand(1);
+          if (!A->getType()->isIntegerTy(16))
+            Fail("overflow arithmetic must use i16");
+          bool Sub = ID == Intrinsic::usub_with_overflow ||
+                     ID == Intrinsic::ssub_with_overflow;
+          Value *Result = Sub ? B.CreateSub(A, ArgB) : B.CreateAdd(A, ArgB);
+          Value *Flag;
+          if (ID == Intrinsic::uadd_with_overflow)
+            Flag = B.CreateICmpULT(Result, A);
+          else if (ID == Intrinsic::usub_with_overflow)
+            Flag = B.CreateICmpULT(A, ArgB);
+          else {
+            Value *Left = B.CreateXor(A, Sub ? ArgB : Result);
+            Value *Right = B.CreateXor(Sub ? A : ArgB, Result);
+            Flag = B.CreateICmpSLT(B.CreateAnd(Left, Right), B.getInt16(0));
+          }
+          while (!Overflow->use_empty()) {
+            auto *Extract = dyn_cast<ExtractValueInst>(*Overflow->user_begin());
+            if (!Extract || Extract->getNumIndices() != 1 ||
+                Extract->getIndices()[0] > 1)
+              Fail("unsupported overflow result use");
+            Extract->replaceAllUsesWith(Extract->getIndices()[0] ? Flag
+                                                                 : Result);
+            Extract->eraseFromParent();
+          }
+        }
+      } else if (isa<LoadInst, StoreInst>(I)) {
+        auto *Load = dyn_cast<LoadInst>(I);
+        auto *Store = dyn_cast<StoreInst>(I);
+        Type *T = Load ? Load->getType() : Store->getValueOperand()->getType();
+        if ((Load && Load->isAtomic()) || (Store && Store->isAtomic()))
+          Fail("atomic memory accesses unsupported");
+        bool Pointer = T->isPointerTy();
+        if (Pointer && T->getPointerAddressSpace() != 0)
+          Fail("non-default address spaces unsupported");
+        if (!Pointer && (!T->isIntegerTy() || T->getIntegerBitWidth() > 16))
+          Fail("memory values must be pointers or integers up to 16 bits");
+        unsigned Bytes = Pointer ? 2 : (T->getIntegerBitWidth() + 7) / 8;
+        Value *Addr = Address(Load ? Load->getPointerOperand()
+                                   : Store->getPointerOperand());
+        Value *V = nullptr;
+        if (Store) {
+          V = Store->getValueOperand();
+          V = Pointer ? B.CreatePtrToInt(V, Word)
+                      : B.CreateZExtOrTrunc(V, Word);
+        }
+        Value *Result = B.getInt16(0);
+        Align Alignment = Load ? Load->getAlign() : Store->getAlign();
+        if (Bytes == 2 && Alignment.value() >= 2) {
+          if (Load)
+            Result = B.CreateCall(Read, {Addr});
+          else
+            B.CreateCall(Write, {Addr, V});
+        } else {
+          for (unsigned Byte = 0; Byte < Bytes; ++Byte) {
+            Value *At = Byte ? B.CreateAdd(Addr, B.getInt16(Byte)) : Addr;
+            if (Load) {
+              Value *Part = B.CreateCall(ReadByte, {At});
+              if (Byte)
+                Part = B.CreateShl(Part, Byte * 8);
+              Result = B.CreateOr(Result, Part);
+            } else {
+              Value *Part = Byte ? B.CreateLShr(V, Byte * 8) : V;
+              B.CreateCall(WriteByte, {At, B.CreateAnd(Part, B.getInt16(255))});
+            }
+          }
+        }
+        if (Load) {
+          Result = Pointer ? B.CreateIntToPtr(Result, T)
+                           : B.CreateTruncOrBitCast(Result, T);
+          Load->replaceAllUsesWith(Result);
+        }
+      }
+      I->eraseFromParent();
+    }
+    return !Work.empty();
+  }
+};
+char N16Memory::ID;
+} // namespace
+INITIALIZE_PASS(N16Memory, "nosuz16-memory", "Nosuz16 packed byte C memory",
+                false, false)
+ModulePass *llvm::createNosuz16MemoryPass() { return new N16Memory(); }
diff --git a/llvm/lib/Target/Nosuz16/Nosuz16Printf.cpp b/llvm/lib/Target/Nosuz16/Nosuz16Printf.cpp
new file mode 100644
index 000000000..6ac1c26c1
--- /dev/null
+++ b/llvm/lib/Target/Nosuz16/Nosuz16Printf.cpp
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#include "Nosuz16.h"
+#include "llvm/Analysis/ValueTracking.h"
+#include "llvm/IR/Constants.h"
+#include "llvm/IR/IRBuilder.h"
+#include "llvm/IR/InstIterator.h"
+#include "llvm/IR/Module.h"
+#include "llvm/Pass.h"
+#include "llvm/Support/ErrorHandling.h"
+
+using namespace llvm;
+
+namespace {
+// This deliberately supports literals without defining a general pointer or
+// variadic ABI. All emitted calls use the existing fixed i16 calling
+// convention.
+class N16Printf final : public ModulePass {
+public:
+  static char ID;
+  N16Printf() : ModulePass(ID) {}
+
+  bool runOnModule(Module &M) override {
+    SmallVector<CallInst *> Calls;
+    for (Function &F : M)
+      for (Instruction &I : instructions(F))
+        if (auto *C = dyn_cast<CallInst>(&I))
+          if (Function *Callee = C->getCalledFunction())
+            if (Callee->getName() == "printf" && Callee->isDeclaration())
+              Calls.push_back(C);
+    if (Calls.empty())
+      return false;
+
+    auto Fail = [](const Twine &Reason) {
+      report_fatal_error(Twine("Nosuz16 printf: ") + Reason, false);
+    };
+    Type *Word = Type::getInt16Ty(M.getContext());
+    for (CallInst *C : Calls) {
+      StringRef Format;
+      if (!C->getType()->isIntegerTy(16) || C->arg_empty() ||
+          !getConstantStringInfo(C->getArgOperand(0), Format))
+        Fail("format must be a constant string and return type must be i16");
+      if (C->isMustTailCall() || C->getCallingConv() != CallingConv::C ||
+          C->hasOperandBundles())
+        Fail("unsupported call attributes");
+      IRBuilder<> B(C);
+      B.SetCurrentDebugLocation(C->getDebugLoc());
+      FunctionCallee Putc = M.getOrInsertFunction("putc", Word, Word);
+      Value *Count = B.getInt16(0);
+      auto EmitByte = [&](Value *Byte) {
+        B.CreateCall(Putc, {Byte});
+        Count = B.CreateAdd(Count, B.getInt16(1));
+      };
+      auto EmitText = [&](StringRef Text) {
+        for (unsigned char Byte : Text.bytes())
+          EmitByte(B.getInt16(Byte));
+      };
+      unsigned Argument = 1;
+      for (size_t Position = 0; Position < Format.size(); ++Position) {
+        unsigned char Ch = Format[Position];
+        if (Ch != '%') {
+          EmitByte(B.getInt16(Ch));
+          continue;
+        }
+        if (++Position == Format.size())
+          Fail("incomplete conversion");
+        Ch = Format[Position];
+        if (Ch == '%') {
+          EmitByte(B.getInt16('%'));
+          continue;
+        }
+        if (Ch != 'd' && Ch != 'i' && Ch != 'u' && Ch != 'x' && Ch != 'X' &&
+            Ch != 'o' && Ch != 'c' && Ch != 's')
+          Fail(
+              "unsupported conversion (supported: %d %i %u %x %X %o %c %s %%)");
+        if (Argument >= C->arg_size())
+          Fail("missing conversion argument");
+        Value *V = C->getArgOperand(Argument++);
+        if (Ch == 's') {
+          StringRef Text;
+          if (getConstantStringInfo(V, Text)) {
+            EmitText(Text);
+          } else {
+            if (!V->getType()->isPointerTy())
+              Fail("%s requires a character pointer");
+            auto Print = M.getOrInsertFunction("__nosuz16_print_string", Word, Word);
+            Value *Written = B.CreateCall(Print, {B.CreatePtrToInt(V, Word)});
+            Count = B.CreateAdd(Count, Written);
+          }
+          continue;
+        }
+        if (!V->getType()->isIntegerTy(16))
+          Fail("integer conversion arguments must be i16");
+        if (Ch == 'c') {
+          EmitByte(V);
+          continue;
+        }
+        Value *Written;
+        if (Ch == 'd' || Ch == 'i') {
+          auto Print =
+              M.getOrInsertFunction("__nosuz16_print_signed", Word, Word);
+          Written = B.CreateCall(Print, {V});
+        } else {
+          auto Print = M.getOrInsertFunction("__nosuz16_print_unsigned", Word,
+                                             Word, Word, Word);
+          unsigned Base = (Ch == 'o') ? 8 : (Ch == 'u') ? 10 : 16;
+          Written =
+              B.CreateCall(Print, {V, B.getInt16(Base), B.getInt16(Ch == 'X')});
+        }
+        Count = B.CreateAdd(Count, Written);
+      }
+      C->replaceAllUsesWith(Count);
+      C->eraseFromParent();
+    }
+    // Literal bytes were emitted as immediate UART arguments. Remove their
+    // dead storage so it cannot reach the word-only object/image pipeline.
+    for (auto I = M.global_begin(), End = M.global_end(); I != End;) {
+      GlobalVariable &G = *I++;
+      if (!G.hasLocalLinkage() || !G.isConstant() || !G.hasInitializer())
+        continue;
+      auto *Array = dyn_cast<ArrayType>(G.getValueType());
+      if (!Array || !Array->getElementType()->isIntegerTy(8))
+        continue;
+      G.removeDeadConstantUsers();
+      if (G.use_empty())
+        G.eraseFromParent();
+    }
+    return true;
+  }
+};
+char N16Printf::ID;
+} // namespace
+
+INITIALIZE_PASS(N16Printf, "nosuz16-printf", "Nosuz16 literal printf expansion",
+                false, false)
+
+ModulePass *llvm::createNosuz16PrintfPass() { return new N16Printf(); }
