diff --git a/llvm/test/CodeGen/Nosuz16/basic.ll b/llvm/test/CodeGen/Nosuz16/basic.ll
new file mode 100644
index 000000000..31654462c
--- /dev/null
+++ b/llvm/test/CodeGen/Nosuz16/basic.ll
@@ -0,0 +1,33 @@
+; RUN: llc -mtriple=nosuz16 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=nosuz16 -O0 -verify-machineinstrs < %s | FileCheck %s
+
+define i16 @arithmetic(i16 %a, i16 %b) {
+; CHECK-LABEL: arithmetic:
+; CHECK: add
+; CHECK: xor
+; CHECK: ret
+  %s = add i16 %a, %b
+  %v = xor i16 %s, 12345
+  ret i16 %v
+}
+
+define i16 @compare(i16 %a, i16 %b) {
+; CHECK-LABEL: compare:
+; CHECK: brcc
+; CHECK: ret
+  %c = icmp slt i16 %a, %b
+  %v = select i1 %c, i16 1, i16 0
+  ret i16 %v
+}
+
+declare i16 @llvm.nosuz16.ldw(i16)
+declare void @llvm.nosuz16.stw(i16, i16)
+define i16 @io() {
+; CHECK-LABEL: io:
+; CHECK: ld
+; CHECK: st
+; CHECK: ret
+  %v = call i16 @llvm.nosuz16.ldw(i16 -256)
+  call void @llvm.nosuz16.stw(i16 -256, i16 %v)
+  ret i16 %v
+}
