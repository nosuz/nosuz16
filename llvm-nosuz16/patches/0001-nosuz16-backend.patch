index 000000000..85b7c5cf3
--- /dev/null
+++ b/clang/test/CodeGen/Nosuz16/scalar.c
@@ -0,0 +1,25 @@
+// RUN: %clang_cc1 -triple nosuz16 -ffreestanding -O2 -emit-llvm -o - %s | FileCheck %s
+// RUN: %clang_cc1 -triple nosuz16 -ffreestanding -O2 -S -o - %s | FileCheck --check-prefix=ASM %s
+// REQUIRES: nosuz16-registered-target
+
+// CHECK-LABEL: define{{.*}} i16 @add(i16{{.*}}, i16
+// CHECK: add{{.*}} i16
+// ASM-LABEL: add:
+// ASM: add
+// ASM: ret
+int add(int a, int b) { return a + b; }
+
+extern unsigned int read_word(unsigned int) __asm__("llvm.nosuz16.ldw");
+extern void write_word(unsigned int, unsigned int) __asm__("llvm.nosuz16.stw");
+// CHECK-LABEL: define{{.*}} i16 @io(
+// CHECK: call i16 @llvm.nosuz16.ldw(i16
+// CHECK: call void @llvm.nosuz16.stw(i16
+// ASM-LABEL: io:
+// ASM: ld
+// ASM: st
+// ASM: ret
+int io(void) {
+  unsigned int v = read_word(0xff00u);
+  write_word(0xff00u, v);
+  return v;
+}
