+static void adjustSP(MachineBasicBlock &B,MachineBasicBlock::iterator I,int64_t Bytes,const DebugLoc &DL) {
+ const auto &TII=*B.getParent()->getSubtarget().getInstrInfo();
+ while (Bytes) {
+  int64_t N=std::clamp<int64_t>(Bytes,-32,31);
+  BuildMI(B,I,DL,TII.get(Nosuz16::ADDI),Nosuz16::R6).addReg(Nosuz16::R6).addImm(N);
+  Bytes-=N;
+ }
+}
+N16RegisterInfo::N16RegisterInfo():Nosuz16GenRegisterInfo(Nosuz16::R7) {}
+const MCPhysReg *N16RegisterInfo::getCalleeSavedRegs(const MachineFunction *) const { return CSR_Function_SaveList; }
+const uint32_t *N16RegisterInfo::getCallPreservedMask(const MachineFunction &,CallingConv::ID) const { return CSR_ABI_RegMask; }
+BitVector N16RegisterInfo::getReservedRegs(const MachineFunction &) const {
+ BitVector B(getNumRegs());
+ for(unsigned R:{Nosuz16::R0,Nosuz16::R5,Nosuz16::R6,Nosuz16::R7,Nosuz16::STATUS}) B.set(R);
+ return B;
+}
+bool N16RegisterInfo::eliminateFrameIndex(MachineBasicBlock::iterator I,int SPAdj,unsigned Op,RegScavenger *) const {
+ MachineInstr &MI=*I; auto &B=*MI.getParent(); auto &F=B.getParent()->getFrameInfo();
+ int64_t Bytes=F.getObjectOffset(MI.getOperand(Op).getIndex())+F.getStackSize()+SPAdj;
+ int64_t W=Bytes+MI.getOperand(Op+1).getImm();
+ if (MI.getOpcode() == Nosuz16::LEA) {
+  const auto &TII = *B.getParent()->getSubtarget().getInstrInfo();
+  Register Dst = MI.getOperand(0).getReg();
+  if (!W) BuildMI(B,I,MI.getDebugLoc(),TII.get(Nosuz16::MOV),Dst).addReg(Nosuz16::R6);
+  else {
+   BuildMI(B,I,MI.getDebugLoc(),TII.get(Nosuz16::LI),Dst).addImm(W);
+   BuildMI(B,I,MI.getDebugLoc(),TII.get(Nosuz16::ADD),Dst).addReg(Dst).addReg(Nosuz16::R6);
+  }
+  MI.eraseFromParent(); return true;
+ }
+ if(Bytes%2) report_fatal_error("Nosuz16: unaligned stack slot",false);
+ MI.getOperand(Op).ChangeToRegister(Nosuz16::R6,false);
+ if(isInt<6>(W)) MI.getOperand(Op+1).setImm(W);
+ else {
+  // Moving SP avoids an unspillable scratch register, including saving R5.
+  adjustSP(B,I,W,MI.getDebugLoc()); MI.getOperand(Op+1).setImm(0);
+  adjustSP(B,std::next(I),-W,MI.getDebugLoc());
+ }
+ return false;
+}
+N16InstrInfo::N16InstrInfo(const TargetSubtargetInfo &ST):Nosuz16GenInstrInfo(ST,RI,Nosuz16::ADJCALLSTACKDOWN,Nosuz16::ADJCALLSTACKUP) {}
+void N16InstrInfo::copyPhysReg(MachineBasicBlock &B,MachineBasicBlock::iterator I,const DebugLoc &DL,Register D,Register S,bool K,bool,bool) const {
+ if(D!=S) BuildMI(B,I,DL,get(Nosuz16::MOV),D).addReg(S,getKillRegState(K));
+}
+void N16InstrInfo::storeRegToStackSlot(MachineBasicBlock &B,MachineBasicBlock::iterator I,Register S,bool K,int FI,const TargetRegisterClass *,Register,MachineInstr::MIFlag Flags) const {
+ BuildMI(B,I,DebugLoc(),get(Nosuz16::ST)).addReg(S,getKillRegState(K)).addFrameIndex(FI).addImm(0).setMIFlag(Flags);
+}
+void N16InstrInfo::loadRegFromStackSlot(MachineBasicBlock &B,MachineBasicBlock::iterator I,Register D,int FI,const TargetRegisterClass *,Register,unsigned,MachineInstr::MIFlag Flags) const {
+ BuildMI(B,I,DebugLoc(),get(Nosuz16::LD),D).addFrameIndex(FI).addImm(0).setMIFlag(Flags);
+}
+bool N16InstrInfo::expandPostRAPseudo(MachineInstr &MI) const {
+ if(MI.getOpcode()!=Nosuz16::LDSP && MI.getOpcode()!=Nosuz16::STSP)return false;
+ auto &B=*MI.getParent();auto I=MI.getIterator();auto L=MI.getDebugLoc();
+ int64_t Bytes=MI.getOperand(2).getImm();
+ adjustSP(B,I,Bytes,L);
+ BuildMI(B,I,L,get(MI.getOpcode()==Nosuz16::LDSP?Nosuz16::LD:Nosuz16::ST)).add(MI.getOperand(0)).add(MI.getOperand(1)).addImm(0).cloneMemRefs(MI);
+ adjustSP(B,std::next(I),-Bytes,L);
+ MI.eraseFromParent();return true;
+}
+bool N16InstrInfo::analyzeBranch(MachineBasicBlock &B,MachineBasicBlock *&T,MachineBasicBlock *&F,SmallVectorImpl<MachineOperand> &C,bool) const {
+ T=F=nullptr; C.clear();
+ for(auto I=B.rbegin();I!=B.rend()&&I->isTerminator();++I) {
+  if(I->getOpcode()==Nosuz16::JMP) { if(T) return true; T=I->getOperand(0).getMBB(); }
+  else if(I->getOpcode()==Nosuz16::BRCC) {
+   if(!C.empty()) return true; F=T; T=I->getOperand(3).getMBB();
+   C.push_back(I->getOperand(0)); C.push_back(I->getOperand(1)); C.push_back(I->getOperand(2));
+  } else return true;
+ }
+ return false;
+}
+unsigned N16InstrInfo::insertBranch(MachineBasicBlock &B,MachineBasicBlock *T,MachineBasicBlock *F,ArrayRef<MachineOperand> C,const DebugLoc &DL,int *Bytes) const {
+ unsigned N=0,Size=0;
+ if(C.empty()) { BuildMI(B,B.end(),DL,get(Nosuz16::JMP)).addMBB(T); N=1; Size=68; }
+ else {
+  BuildMI(B,B.end(),DL,get(Nosuz16::BRCC)).add(C[0]).add(C[1]).add(C[2]).addMBB(T); N=1; Size=C[2].getImm()==ISD::SETGE||C[2].getImm()==ISD::SETLE?74:72;
+  if(F) { BuildMI(B,B.end(),DL,get(Nosuz16::JMP)).addMBB(F); ++N;Size+=68; }
+ }
+ if(Bytes)*Bytes=Size;return N;
+}
+unsigned N16InstrInfo::removeBranch(MachineBasicBlock &B,int *Bytes) const {
+ unsigned N=0,S=0;
+ while(!B.empty() && (B.back().getOpcode()==Nosuz16::JMP || B.back().getOpcode()==Nosuz16::BRCC)) {
+  S+=getInstSizeInBytes(B.back());B.back().eraseFromParent();++N;
+ }
+ if(Bytes)*Bytes=S; return N;
+}
+bool N16InstrInfo::isBranchOffsetInRange(unsigned Op,int64_t Offset) const {
+ if(Offset%2)return false;
+ if(Op==Nosuz16::BEQ||Op==Nosuz16::BNE||Op==Nosuz16::BLT)return isInt<6>((Offset-2)/2);
+ if(Op==Nosuz16::JAL)return isInt<9>((Offset-2)/2);
+ return Offset>=-65534 && Offset<=65534;
+}
+MachineBasicBlock *N16InstrInfo::getBranchDestBlock(const MachineInstr &MI) const {
+ unsigned Op=MI.getOpcode();
+ unsigned Index=Op==Nosuz16::BRCC?3:Op==Nosuz16::JAL?1:Op==Nosuz16::BEQ||Op==Nosuz16::BNE||Op==Nosuz16::BLT?2:0;
+ return MI.getOperand(Index).getMBB();
+}
+unsigned N16InstrInfo::getInstSizeInBytes(const MachineInstr &MI) const {
+ if(MI.getOpcode()==Nosuz16::LDSP||MI.getOpcode()==Nosuz16::STSP) {
+  uint64_t Bytes=std::abs(MI.getOperand(2).getImm());
+  return 2+2*((Bytes+30)/31+(Bytes+31)/32);
+ }
+ if(MI.getOpcode()==Nosuz16::BRCC) {
+  auto CC=(ISD::CondCode)MI.getOperand(2).getImm();
+  return CC==ISD::SETGE||CC==ISD::SETLE?74:72;
+ }
+ if(MI.getOpcode()==Nosuz16::MOV && MI.getOperand(0).getReg()==MI.getOperand(1).getReg())return 2;
+ return MI.getDesc().getSize();
+}
+bool N16InstrInfo::reverseBranchCondition(SmallVectorImpl<MachineOperand> &C) const {
+ C[2].setImm(ISD::getSetCCInverse((ISD::CondCode)C[2].getImm(),MVT::i16));return false;
+}
+void Nosuz16FrameLowering::emitPrologue(MachineFunction &MF,MachineBasicBlock &B) const {
+ auto &F=MF.getFrameInfo();
+ if(F.hasVarSizedObjects()) report_fatal_error("Nosuz16: dynamic stack allocation is unsupported",false);
+ if(F.getStackSize()>65534)report_fatal_error("Nosuz16: stack frame exceeds address space",false);
+ adjustSP(B,B.begin(),-int64_t(F.getStackSize()),DebugLoc());
+}
+void Nosuz16FrameLowering::emitEpilogue(MachineFunction &MF,MachineBasicBlock &B) const {
+ adjustSP(B,B.getLastNonDebugInstr(),MF.getFrameInfo().getStackSize(),DebugLoc());
+}
+MachineBasicBlock::iterator Nosuz16FrameLowering::eliminateCallFramePseudoInstr(MachineFunction &,MachineBasicBlock &B,MachineBasicBlock::iterator I) const {return B.erase(I);}
