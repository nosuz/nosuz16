+const char *N16Lowering::getTargetNodeName(unsigned Op) const {
+ switch(Op) {
+#define N(X) case N16ISD::X:return "N16ISD::" #X;
+ N(RET) N(CALL) N(BRCC) N(SELECT) N(SHL) N(SRL) N(SRA) N(SHL1) N(SRL1) N(SRA1) N(LDW) N(STW) N(LDB) N(STB) N(ADDRESS)
+#undef N
