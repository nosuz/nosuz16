+};
+class Nosuz16FrameLowering final : public TargetFrameLowering {
+public:
+ Nosuz16FrameLowering():TargetFrameLowering(StackGrowsDown,Align(2),0,Align(2)) {}
+ bool hasReservedCallFrame(const MachineFunction &) const override { return true; }
