+ for(unsigned Op:{ISD::SHL,ISD::SRL,ISD::SRA}) setOperationAction(Op,MVT::i16,Custom);
+ setOperationAction(ISD::INTRINSIC_W_CHAIN,MVT::Other,Custom);
