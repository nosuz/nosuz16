diff --git a/clang/lib/Basic/Targets/Nosuz16.h b/clang/lib/Basic/Targets/Nosuz16.h
new file mode 100644
index 000000000..30410be09
--- /dev/null
+++ b/clang/lib/Basic/Targets/Nosuz16.h
@@ -0,0 +1,76 @@
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+#ifndef LLVM_CLANG_LIB_BASIC_TARGETS_NOSUZ16_H
+#define LLVM_CLANG_LIB_BASIC_TARGETS_NOSUZ16_H
+
+#include "clang/Basic/MacroBuilder.h"
+#include "clang/Basic/TargetInfo.h"
+#include "clang/Basic/TargetOptions.h"
+
+namespace clang::targets {
+
+// v2.5 uses packed eight-bit bytes and 16-bit byte-addressed pointers.
+class LLVM_LIBRARY_VISIBILITY Nosuz16TargetInfo final : public TargetInfo {
+public:
+  Nosuz16TargetInfo(const llvm::Triple &Triple, const TargetOptions &)
+      : TargetInfo(Triple) {
+    TLSSupported = false;
+    IntWidth = IntAlign = 16;
+    LongWidth = 32;
+    LongLongWidth = 64;
+    LongAlign = LongLongAlign = 16;
+    FloatWidth = 32;
+    FloatAlign = 16;
+    DoubleWidth = LongDoubleWidth = 64;
+    DoubleAlign = LongDoubleAlign = 16;
+    PointerWidth = PointerAlign = 16;
+    SuitableAlign = 16;
+    SizeType = UnsignedInt;
+    IntMaxType = SignedLongLong;
+    IntPtrType = SignedInt;
+    PtrDiffType = SignedInt;
+    SigAtomicType = SignedInt;
+    MaxAtomicPromoteWidth = 16;
+    MaxAtomicInlineWidth = 0;
+    resetDataLayout();
+  }
+
+  void getTargetDefines(const LangOptions &,
+                        MacroBuilder &Builder) const override {
+    Builder.defineMacro("__NOSUZ16__");
+    Builder.defineMacro("__NOSUZ16_SCALAR_C__");
+    Builder.defineMacro("__NOSUZ16_WORD_BITS__", "16");
+    Builder.defineMacro("__NOSUZ16_BYTE_ADDRESSABLE__");
+    Builder.defineMacro("__NOSUZ16_SPEC_VERSION__", "205");
+  }
+
+  llvm::SmallVector<Builtin::InfosShard> getTargetBuiltins() const override {
+    return {};
+  }
+  bool isValidCPUName(StringRef Name) const override {
+    return Name == "generic";
+  }
+  bool setCPU(StringRef Name) override { return isValidCPUName(Name); }
+  void fillValidCPUList(SmallVectorImpl<StringRef> &Values) const override {
+    Values.push_back("generic");
+  }
+  bool hasFeature(StringRef Feature) const override {
+    return Feature == "nosuz16";
+  }
+
+  ArrayRef<const char *> getGCCRegNames() const override {
+    static const char *const Names[] = {"r0", "r1", "r2", "r3",
+                                        "r4", "r5", "r6", "r7"};
+    return Names;
+  }
+  ArrayRef<GCCRegAlias> getGCCRegAliases() const override { return {}; }
+  bool validateAsmConstraint(const char *&, ConstraintInfo &) const override {
+    return false;
+  }
+  std::string_view getClobbers() const override { return ""; }
+  BuiltinVaListKind getBuiltinVaListKind() const override {
+    return CharPtrBuiltinVaList;
+  }
+};
+
+} // namespace clang::targets
+#endif
diff --git a/clang/test/CodeGen/Nosuz16/scalar.c b/clang/test/CodeGen/Nosuz16/scalar.c
