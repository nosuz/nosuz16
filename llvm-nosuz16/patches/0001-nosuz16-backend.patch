+static void signedCondition(SDValue &A,SDValue &B,ISD::CondCode &CC,SelectionDAG &D,const SDLoc &L) {
+ if(ISD::isUnsignedIntSetCC(CC)) {
+  SDValue Bias=D.getConstant(0x8000,L,MVT::i16);
+  A=D.getNode(ISD::XOR,L,MVT::i16,A,Bias); B=D.getNode(ISD::XOR,L,MVT::i16,B,Bias);
+  switch(CC) {case ISD::SETULT:CC=ISD::SETLT;break;case ISD::SETULE:CC=ISD::SETLE;break;case ISD::SETUGT:CC=ISD::SETGT;break;case ISD::SETUGE:CC=ISD::SETGE;break;default:llvm_unreachable("unsigned CC");}
+ }
+}
+SDValue N16Lowering::LowerOperation(SDValue O,SelectionDAG &D) const {
+ SDLoc L(O);auto C=[&](int64_t V){return D.getTargetConstant(V,L,MVT::i16);};
+ switch(O.getOpcode()) {
+ case ISD::GlobalAddress: {
+  auto *G = cast<GlobalAddressSDNode>(O);
+  return D.getNode(N16ISD::ADDRESS,L,MVT::i16,
+                   D.getTargetGlobalAddress(G->getGlobal(),L,MVT::i16,G->getOffset()));
+ }
+ case ISD::BR_CC: {
+  auto CC=cast<CondCodeSDNode>(O.getOperand(1))->get(); SDValue A=O.getOperand(2),B=O.getOperand(3);
+  signedCondition(A,B,CC,D,L);return D.getNode(N16ISD::BRCC,L,MVT::Other,O.getOperand(0),A,B,C(CC),O.getOperand(4));
+ }
+ case ISD::SETCC: case ISD::SELECT_CC: {
+  SDValue A=O.getOperand(0),B=O.getOperand(1),T,F;ISD::CondCode CC;
+  if(O.getOpcode()==ISD::SETCC) {CC=cast<CondCodeSDNode>(O.getOperand(2))->get();T=D.getConstant(1,L,MVT::i16);F=D.getConstant(0,L,MVT::i16);}
+  else {T=O.getOperand(2);F=O.getOperand(3);CC=cast<CondCodeSDNode>(O.getOperand(4))->get();}
+  signedCondition(A,B,CC,D,L);
+  return D.getNode(N16ISD::SELECT,L,MVT::i16,A,B,C(CC),T,F);
+ }
+ case ISD::SHL:case ISD::SRL:case ISD::SRA:
+  if(auto *Amount=dyn_cast<ConstantSDNode>(O.getOperand(1))) {
+   unsigned Count=std::min<uint64_t>(Amount->getZExtValue(),16);
+   SDValue Result=O.getOperand(0);
+   unsigned Op=O.getOpcode()==ISD::SHL?N16ISD::SHL1:O.getOpcode()==ISD::SRL?N16ISD::SRL1:N16ISD::SRA1;
+   for(unsigned I=0;I<Count;++I)Result=D.getNode(Op,L,MVT::i16,Result);
+   return Result;
+  }
+  return D.getNode(O.getOpcode()==ISD::SHL?N16ISD::SHL:O.getOpcode()==ISD::SRL?N16ISD::SRL:N16ISD::SRA,L,MVT::i16,O.getOperand(0),O.getOperand(1));
+ case ISD::INTRINSIC_W_CHAIN:case ISD::INTRINSIC_VOID: {
+  unsigned ID=O.getOperand(1)->getAsZExtVal();
+  if(ID==Intrinsic::nosuz16_ldw)return D.getNode(N16ISD::LDW,L,D.getVTList(MVT::i16,MVT::Other),O.getOperand(2),O.getOperand(0));
+  if(ID==Intrinsic::nosuz16_ldb)return D.getNode(N16ISD::LDB,L,D.getVTList(MVT::i16,MVT::Other),O.getOperand(2),O.getOperand(0));
+  if(ID==Intrinsic::nosuz16_stb)return D.getNode(N16ISD::STB,L,MVT::Other,O.getOperand(3),O.getOperand(2),O.getOperand(0));
+  if(ID==Intrinsic::nosuz16_stw)return D.getNode(N16ISD::STW,L,MVT::Other,O.getOperand(3),O.getOperand(2),O.getOperand(0));
+  report_fatal_error("Nosuz16: unsupported intrinsic",false);
+ }
+ default:report_fatal_error("Nosuz16: unsupported operation or generic pointer access",false);
+ }
+}
+static SDValue extendABIValue(SDValue V,const ISD::OutputArg &Arg,SelectionDAG &D,const SDLoc &L) {
+ if(Arg.ArgVT.isInteger() && Arg.ArgVT.getSizeInBits()<16) {
+  unsigned Bits=Arg.ArgVT.getSizeInBits();
+  if(Bits>1 && Arg.Flags.isSExt())return D.getNode(ISD::SIGN_EXTEND_INREG,L,MVT::i16,V,D.getValueType(Arg.ArgVT));
+  return D.getNode(ISD::AND,L,MVT::i16,V,D.getConstant((1u<<Bits)-1,L,MVT::i16));
+ }
+ return V;
+}
+SDValue N16Lowering::LowerFormalArguments(SDValue Chain,CallingConv::ID CC,bool VarArg,const SmallVectorImpl<ISD::InputArg> &Ins,const SDLoc &L,SelectionDAG &D,SmallVectorImpl<SDValue> &Vals) const {
+ if(VarArg || CC!=CallingConv::C)report_fatal_error("Nosuz16: only fixed-argument C calling convention is supported",false);
+ auto &MF=D.getMachineFunction();unsigned Regs[]={Nosuz16::R1,Nosuz16::R2,Nosuz16::R3};
+ for(unsigned I=0;I<Ins.size();++I) {
+  if(Ins[I].VT!=MVT::i16)report_fatal_error("Nosuz16: argument must be i16",false);
+  if(I<3) {Register V=MF.getRegInfo().createVirtualRegister(&Nosuz16::GPRRegClass);MF.getRegInfo().addLiveIn(Regs[I],V);Vals.push_back(D.getCopyFromReg(Chain,L,V,MVT::i16));}
+  else {int FI=MF.getFrameInfo().CreateFixedObject(2,(I-3)*2,true);SDValue V=D.getLoad(MVT::i16,L,Chain,D.getFrameIndex(FI,MVT::i16),MachinePointerInfo::getFixedStack(MF,FI));Vals.push_back(V);Chain=V.getValue(1);}
+ }
+ return Chain;
+}
+SDValue N16Lowering::LowerReturn(SDValue Chain,CallingConv::ID,bool,const SmallVectorImpl<ISD::OutputArg> &Outs,const SmallVectorImpl<SDValue> &Vals,const SDLoc &L,SelectionDAG &D) const {
+ if(Outs.size()>1)report_fatal_error("Nosuz16: return type must be void or i16",false);
+ SDValue Glue;SmallVector<SDValue,4> Ops;
+ if(!Outs.empty()) {Chain=D.getCopyToReg(Chain,L,Nosuz16::R1,extendABIValue(Vals[0],Outs[0],D,L),SDValue());Glue=Chain.getValue(1);}
+ Ops.push_back(Chain);if(!Outs.empty())Ops.push_back(D.getRegister(Nosuz16::R1,MVT::i16));if(Glue)Ops.push_back(Glue);
+ return D.getNode(N16ISD::RET,L,MVT::Other,Ops);
+}
+SDValue N16Lowering::LowerCall(CallLoweringInfo &CLI,SmallVectorImpl<SDValue> &Vals) const {
+ auto &D=CLI.DAG;auto L=CLI.DL;SDValue Chain=CLI.Chain,Callee=CLI.Callee;
+ CLI.IsTailCall=false;
+ if(CLI.IsVarArg || CLI.CallConv!=CallingConv::C)report_fatal_error("Nosuz16: unsupported call convention",false);
+ unsigned Bytes=CLI.Outs.size()>3?(CLI.Outs.size()-3)*2:0;
+ if(Bytes>32766)report_fatal_error("Nosuz16: outgoing argument area exceeds supported byte-offset range",false);
+ Chain=D.getCALLSEQ_START(Chain,Bytes,0,L);
+ for(unsigned I=3;I<CLI.OutVals.size();++I) {
+  SDValue SP=D.getCopyFromReg(Chain,L,Nosuz16::R6,MVT::i16);
+  SDValue P=D.getNode(ISD::ADD,L,MVT::i16,SP,D.getConstant((I-3)*2,L,MVT::i16));
+  Chain=D.getStore(Chain,L,extendABIValue(CLI.OutVals[I],CLI.Outs[I],D,L),P,MachinePointerInfo());
+ }
+ SDValue Glue;unsigned Regs[]={Nosuz16::R1,Nosuz16::R2,Nosuz16::R3};
+ for(unsigned I=0;I<std::min<size_t>(3,CLI.OutVals.size());++I) {Chain=D.getCopyToReg(Chain,L,Regs[I],extendABIValue(CLI.OutVals[I],CLI.Outs[I],D,L),Glue);Glue=Chain.getValue(1);}
+ if(auto *G=dyn_cast<GlobalAddressSDNode>(Callee))Callee=D.getTargetGlobalAddress(G->getGlobal(),L,MVT::i16);
+ else if(auto *E=dyn_cast<ExternalSymbolSDNode>(Callee))Callee=D.getTargetExternalSymbol(E->getSymbol(),MVT::i16);
+ else report_fatal_error("Nosuz16: indirect calls are not yet supported",false);
+ SmallVector<SDValue,8> Ops={Chain,Callee};
+ Ops.push_back(D.getRegisterMask(D.getSubtarget().getRegisterInfo()->getCallPreservedMask(D.getMachineFunction(),CLI.CallConv)));
+ for(unsigned I=0;I<std::min<size_t>(3,CLI.OutVals.size());++I)Ops.push_back(D.getRegister(Regs[I],MVT::i16));
+ if(Glue)Ops.push_back(Glue);
+ Chain=D.getNode(N16ISD::CALL,L,D.getVTList(MVT::Other,MVT::Glue),Ops);Glue=Chain.getValue(1);
+ Chain=D.getCALLSEQ_END(Chain,Bytes,0,Glue,L);Glue=Chain.getValue(1);
+ if(CLI.Ins.size()>1)report_fatal_error("Nosuz16: unsupported multiword return",false);
+ if(!CLI.Ins.empty()) {SDValue R=D.getCopyFromReg(Chain,L,Nosuz16::R1,MVT::i16,Glue);Vals.push_back(R);Chain=R.getValue(1);}
+ return Chain;
+}
+MachineBasicBlock *N16Lowering::EmitInstrWithCustomInserter(MachineInstr &MI,MachineBasicBlock *B) const {
+ auto &MF=*B->getParent();auto &MRI=MF.getRegInfo();const auto &II=*MF.getSubtarget().getInstrInfo();DebugLoc L=MI.getDebugLoc();
+ auto newReg=[&](){return MRI.createVirtualRegister(&Nosuz16::GPRRegClass);};
+ auto make=[&](){auto *N=MF.CreateMachineBasicBlock(B->getBasicBlock());MF.insert(std::next(B->getIterator()),N);return N;};
+ if(MI.getOpcode()==Nosuz16::SELECT) {
+  auto *Done=make();auto *False=make();Done->splice(Done->begin(),B,std::next(MI.getIterator()),B->end());Done->transferSuccessorsAndUpdatePHIs(B);
+  B->addSuccessor(Done);B->addSuccessor(False);False->addSuccessor(Done);
+  BuildMI(*B,B->end(),L,II.get(Nosuz16::BRCC)).addReg(MI.getOperand(1).getReg()).addReg(MI.getOperand(2).getReg()).addImm(MI.getOperand(3).getImm()).addMBB(Done);
+  BuildMI(*Done,Done->begin(),L,II.get(TargetOpcode::PHI),MI.getOperand(0).getReg()).addReg(MI.getOperand(4).getReg()).addMBB(B).addReg(MI.getOperand(5).getReg()).addMBB(False);
+  MI.eraseFromParent();return Done;
+ }
+ unsigned Shift=MI.getOpcode()==Nosuz16::VSHL?Nosuz16::SLL:MI.getOpcode()==Nosuz16::VSRL?Nosuz16::SRL:Nosuz16::ASR;
+ auto *Done=make();auto *Body=make();auto *Test=make();Done->splice(Done->begin(),B,std::next(MI.getIterator()),B->end());Done->transferSuccessorsAndUpdatePHIs(B);
+ Register V=newReg(),Count=newReg(),NextV=newReg(),NextC=newReg();
+ B->addSuccessor(Test);Test->addSuccessor(Done);Test->addSuccessor(Body);Body->addSuccessor(Test);
+ BuildMI(*Test,Test->end(),L,II.get(TargetOpcode::PHI),V).addReg(MI.getOperand(1).getReg()).addMBB(B).addReg(NextV).addMBB(Body);
+ BuildMI(*Test,Test->end(),L,II.get(TargetOpcode::PHI),Count).addReg(MI.getOperand(2).getReg()).addMBB(B).addReg(NextC).addMBB(Body);
+ BuildMI(*Test,Test->end(),L,II.get(Nosuz16::BRCC)).addReg(Count).addReg(Nosuz16::R0).addImm(ISD::SETEQ).addMBB(Done);
+ BuildMI(*Body,Body->end(),L,II.get(Shift),NextV).addReg(V);
+ BuildMI(*Body,Body->end(),L,II.get(Nosuz16::ADDI),NextC).addReg(Count).addImm(-1);
+ BuildMI(*Body,Body->end(),L,II.get(Nosuz16::JMP)).addMBB(Test);
+ BuildMI(*Done,Done->begin(),L,II.get(TargetOpcode::COPY),MI.getOperand(0).getReg()).addReg(V);
+ MI.eraseFromParent();return Done;
+}
+namespace {
+class N16Selector : public SelectionDAGISel {
+public:
+ N16Selector(N16TargetMachine &TM,CodeGenOptLevel OL):SelectionDAGISel(TM,OL) {}
+ void Select(SDNode *N) override {
+  if(N->isMachineOpcode()){N->setNodeId(-1);return;}
+  SDLoc L(N);auto C=[&](int64_t V){return CurDAG->getTargetConstant(V,L,MVT::i16);};
+  unsigned Opc=0;SmallVector<SDValue,8> Ops;SDVTList VTs=N->getVTList();
+  switch(N->getOpcode()) {
+  case ISD::CALLSEQ_START:Opc=Nosuz16::ADJCALLSTACKDOWN;Ops={C(cast<ConstantSDNode>(N->getOperand(1))->getZExtValue()),C(0),N->getOperand(0)};break;
+  case ISD::CALLSEQ_END:Opc=Nosuz16::ADJCALLSTACKUP;Ops={N->getOperand(1),N->getOperand(2),N->getOperand(0)};if(N->getNumOperands()>3)Ops.push_back(N->getOperand(3));break;
+  case ISD::Constant:Opc=Nosuz16::LI;Ops={C(N->getAsZExtVal())};break;
+  case ISD::ADD:Opc=Nosuz16::ADD;break;case ISD::SUB:Opc=Nosuz16::SUB;break;
+  case ISD::AND:Opc=Nosuz16::AND;break;case ISD::OR:Opc=Nosuz16::OR;break;case ISD::XOR:Opc=Nosuz16::XOR;break;
+  case N16ISD::SHL1:Opc=Nosuz16::SLL;break;case N16ISD::SRL1:Opc=Nosuz16::SRL;break;case N16ISD::SRA1:Opc=Nosuz16::ASR;break;
+  case N16ISD::SHL:Opc=Nosuz16::VSHL;break;case N16ISD::SRL:Opc=Nosuz16::VSRL;break;case N16ISD::SRA:Opc=Nosuz16::VSRA;break;
+  case N16ISD::SELECT:Opc=Nosuz16::SELECT;break;
+  case ISD::BR:Opc=Nosuz16::JMP;Ops={N->getOperand(1),N->getOperand(0)};break;
+  case N16ISD::BRCC:Opc=Nosuz16::BRCC;Ops={N->getOperand(1),N->getOperand(2),N->getOperand(3),N->getOperand(4),N->getOperand(0)};break;
+  case N16ISD::RET:Opc=Nosuz16::RET;Ops.append(N->op_begin()+1,N->op_end()); { SDValue G; if(!Ops.empty() && Ops.back().getValueType()==MVT::Glue) {G=Ops.pop_back_val();} Ops.push_back(N->getOperand(0)); if(G)Ops.push_back(G); } break;
+  case N16ISD::CALL:Opc=Nosuz16::CALL;Ops.append(N->op_begin()+1,N->op_end()); { SDValue G; if(!Ops.empty() && Ops.back().getValueType()==MVT::Glue) {G=Ops.pop_back_val();} Ops.push_back(N->getOperand(0)); if(G)Ops.push_back(G); } break;
+  case N16ISD::ADDRESS:Opc=Nosuz16::LI;Ops={N->getOperand(0)};break;
+  case ISD::FrameIndex:Opc=Nosuz16::LEA;Ops={CurDAG->getTargetFrameIndex(cast<FrameIndexSDNode>(N)->getIndex(),MVT::i16),C(0)};break;
+  case N16ISD::LDW:Opc=Nosuz16::LD;Ops={N->getOperand(0),C(0),N->getOperand(1)};break;
+  case N16ISD::LDB:Opc=Nosuz16::LDB;Ops={N->getOperand(0),C(0),N->getOperand(1)};break;
+  case N16ISD::STB:Opc=Nosuz16::STB;Ops={N->getOperand(0),N->getOperand(1),C(0),N->getOperand(2)};break;
+  case N16ISD::STW:Opc=Nosuz16::ST;Ops={N->getOperand(0),N->getOperand(1),C(0),N->getOperand(2)};break;
+  case ISD::LOAD:case ISD::STORE: {
+   bool Load=N->getOpcode()==ISD::LOAD;auto *Mem=cast<MemSDNode>(N);
+   if(Mem->getMemoryVT()!=MVT::i16)report_fatal_error("Nosuz16: only word stack slots are supported",false);
+   SDValue Addr=Load?cast<LoadSDNode>(N)->getBasePtr():cast<StoreSDNode>(N)->getBasePtr();int64_t Offset=0;
+   if(Addr.getOpcode()==ISD::ADD && isa<ConstantSDNode>(Addr.getOperand(1))) {Offset=cast<ConstantSDNode>(Addr.getOperand(1))->getSExtValue();Addr=Addr.getOperand(0);}
+   if(Offset%2)report_fatal_error("Nosuz16: unaligned stack access",false);
+   if(Addr.getOpcode()==ISD::FrameIndex)Addr=CurDAG->getTargetFrameIndex(cast<FrameIndexSDNode>(Addr)->getIndex(),MVT::i16);
+   else {
+    if(Addr.getOpcode()!=ISD::CopyFromReg||cast<RegisterSDNode>(Addr.getOperand(1))->getReg()!=Nosuz16::R6)report_fatal_error("Nosuz16: generic pointer access unsupported; use word intrinsics",false);
+    Addr=CurDAG->getRegister(Nosuz16::R6,MVT::i16);
+   }
+   Opc=Load?Nosuz16::LD:Nosuz16::ST;
+   if(Addr.getOpcode()==ISD::Register&&!isInt<6>(Offset))Opc=Load?Nosuz16::LDSP:Nosuz16::STSP;
+   if(!Load)Ops.push_back(cast<StoreSDNode>(N)->getValue());Ops.push_back(Addr);Ops.push_back(C(Offset));Ops.push_back(N->getOperand(0));break;
+  }
+  default:{static const uint8_t Empty[]={OPC_Scope,0};SelectCodeCommon(N,Empty,sizeof(Empty),nullptr);return;}
+  }
+  if(Ops.empty())Ops.append(N->op_begin(),N->op_end());
+  CurDAG->SelectNodeTo(N,Opc,VTs,Ops);
+ }
+};
+class N16SelectorLegacy : public SelectionDAGISelLegacy {
+public:static char ID;N16SelectorLegacy(N16TargetMachine &TM,CodeGenOptLevel OL):SelectionDAGISelLegacy(ID,std::make_unique<N16Selector>(TM,OL)) {}
+};char N16SelectorLegacy::ID;
+class N16Validate : public FunctionPass {
+public:static char ID;N16Validate():FunctionPass(ID) {}
+ bool runOnFunction(Function &F) override {
+  if(F.isDeclaration())return false;
+  if(F.isVarArg())report_fatal_error("Nosuz16: variadic functions unsupported",false);
+  auto Scalar = [](Type *T) {return (T->isPointerTy() && T->getPointerAddressSpace()==0) || (T->isIntegerTy() && T->getIntegerBitWidth()<=16);};
+  if(!F.getReturnType()->isVoidTy() && !Scalar(F.getReturnType()))report_fatal_error("Nosuz16: return must be void, a pointer, or an integer up to i16",false);
+  for(auto &A:F.args()) {
+   if(!Scalar(A.getType()))report_fatal_error("Nosuz16: arguments must be pointers or integers up to i16",false);
+   if(A.hasByValAttr() || A.hasStructRetAttr())report_fatal_error("Nosuz16: aggregate argument/return ABI unsupported",false);
+  }
+  for(auto &I:instructions(F)) {
+   if(auto *A=dyn_cast<AllocaInst>(&I)) {
+    if(!A->getMetadata("nosuz16.frame"))report_fatal_error("Nosuz16: unlowered stack object",false);
+    continue;
+   }
+   if(!I.getType()->isVoidTy() && !Scalar(I.getType()) && !isa<AllocaInst>(I))report_fatal_error("Nosuz16: unsupported value type",false);
+   for(auto &O:I.operands()) {
+    if(isa<GetElementPtrInst>(I) && isa<ConstantInt>(O))continue;
+    auto *T=O->getType();
+    if(T->isFloatingPointTy()||T->isVectorTy()||T->isAggregateType()||(T->isIntegerTy()&&T->getIntegerBitWidth()>16))report_fatal_error("Nosuz16: unsupported operand type",false);
+   }
+   if(isa<LoadInst>(I)||isa<StoreInst>(I)||(isa<AllocaInst>(I)&&!I.getMetadata("nosuz16.frame")))report_fatal_error("Nosuz16: unlowered memory operation",false);
+   if(isa<AtomicRMWInst>(I)||isa<AtomicCmpXchgInst>(I)||isa<FenceInst>(I))report_fatal_error("Nosuz16: atomic operations unsupported",false);
+   if(isa<InvokeInst>(I)||isa<CallBrInst>(I))report_fatal_error("Nosuz16: exceptional calls unsupported",false);
+   if(auto *Call=dyn_cast<CallInst>(&I))if(Call->isMustTailCall())report_fatal_error("Nosuz16: musttail calls unsupported",false);
+   if(auto *C=dyn_cast<CallBase>(&I)) {
+    if(C->isInlineAsm())report_fatal_error("Nosuz16: inline assembly in IR unsupported",false);
+    if(!C->getCalledFunction())report_fatal_error("Nosuz16: indirect calls unsupported",false);
+    for(unsigned A=0;A<C->arg_size();++A)if(C->paramHasAttr(A,Attribute::ByVal)||C->paramHasAttr(A,Attribute::StructRet))report_fatal_error("Nosuz16: aggregate call ABI unsupported",false);
+    if(!C->getCalledFunction()->isIntrinsic())for(auto &A:C->args())if(!Scalar(A->getType()))report_fatal_error("Nosuz16: call arguments must be scalar words",false);
+   }
+  }
+  return false;
+ }
+};char N16Validate::ID;
+class N16PassConfig : public TargetPassConfig {
+public:N16PassConfig(N16TargetMachine &TM,PassManagerBase &PM):TargetPassConfig(TM,PM) {}
+ void addIRPasses() override {addPass(createNosuz16PrintfPass());TargetPassConfig::addIRPasses();}
+ bool addPreISel() override {addPass(createNosuz16MemoryPass());addPass(new N16Validate());return false;}
+ bool addInstSelector() override {addPass(new N16SelectorLegacy(getTM<N16TargetMachine>(),getOptLevel()));return false;}
+};
+}
+INITIALIZE_PASS(N16SelectorLegacy,"nosuz16-isel","Nosuz16 DAG instruction selection",false,false)
+INITIALIZE_PASS(N16Validate,"nosuz16-validate","Nosuz16 IR validation",false,false)
+TargetPassConfig *N16TargetMachine::createPassConfig(PassManagerBase &P){return new N16PassConfig(*this,P);}
+extern "C" LLVM_ABI LLVM_EXTERNAL_VISIBILITY void LLVMInitializeNosuz16Target() {
+ initializeN16SelectorLegacyPass(*PassRegistry::getPassRegistry());
+ initializeN16ValidatePass(*PassRegistry::getPassRegistry());
+ initializeN16PrintfPass(*PassRegistry::getPassRegistry());
+ initializeN16MemoryPass(*PassRegistry::getPassRegistry());
+ RegisterTargetMachine<N16TargetMachine> TM(getTheNosuz16Target());
+}
